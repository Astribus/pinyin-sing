{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拼音 Sing",
  "mainBinaryName": "PinyinSing",
  "version": "0.1.0",
  "identifier": "io.github.astribus.pinyinsing",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "拼音 Sing",
        "width": 640,
        "height": 250,
        "minWidth": 320,
        "minHeight": 110,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
