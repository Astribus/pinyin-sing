{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拼音 Sing",
  "mainBinaryName": "PinyinSing",
  "version": "0.2.0",
  "identifier": "io.github.astribus.pinyinsing",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "dashboard",
        "title": "拼音 Sing",
        "url": "dashboard.html",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      },
      {
        "label": "island",
        "title": "拼音 Sing",
        "width": 640,
        "height": 250,
        "minWidth": 320,
        "minHeight": 110,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}